def detectar_rotas_circulares(linhas: dict[str, list[str]]) -> set[tuple[str, str]]:
    pares = set()
    
    for estacao, conexoes in linhas.items():
        for vizinha in conexoes:
            # Verifica se a volta também existe
            if vizinha in linhas and estacao in linhas[vizinha]:
                # Salva sempre na ordem alfabética pra não duplicar (A,B e B,A = mesmo par)
                if estacao < vizinha:
                    pares.add((estacao, vizinha))
    
    return pares
